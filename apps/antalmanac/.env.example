# Shared
OIDC_ISSUER_URL=https://auth.icssc.club
ANTEATER_API_KEY=<replace me>

# Scheduler
STAGE=local
DB_URL="postgres://postgres:postgres@localhost:5432/antalmanac"
OIDC_CLIENT_ID=antalmanac-dev
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-me

# Planner
PUBLIC_API_URL=https://anteaterapi.com/v2/rest/
PORT=8080
PRODUCTION_DOMAIN=http://localhost:3000
PLANNER_OIDC_CLIENT_ID=peterportal-dev
# below are stubs of variables/secrets for the PostgreSQL database and Google oauth
# these are necessary for features that require logging in
# PLANNER_DATABASE_URL=<secret>
# ADMIN_EMAILS=["<your email>"]
PLANNER_SESSION_SECRET=<randomly-generated-secret-goes-here>

# PLANNER_CLIENT_API_KEY=<secret>

# Planner MCP server (lets external AI agents help students plan, authenticated via @uci.edu Google).
# Reuses OIDC_ISSUER_URL, PLANNER_OIDC_CLIENT_ID, PLANNER_DATABASE_URL, ANTEATER_API_KEY and PRODUCTION_DOMAIN.
# The OAuth issuer/redirect URIs use PRODUCTION_DOMAIN when set, otherwise the request origin. Register
# `<origin>/planner/api/mcp/auth/google/callback` as an allowed redirect URI with the OIDC provider.
# MCP_TOKEN_TTL_SECONDS=3600        # access-token lifetime (default 3600)
# MCP_DAILY_REQUEST_LIMIT=200       # per-student daily tool-call cap (default 200)
# MCP_DEV_BYPASS_AUTH=false         # DEV ONLY: skip OAuth and act as MCP_DEV_USER_ID. Never enable in production.
# MCP_DEV_USER_ID=
