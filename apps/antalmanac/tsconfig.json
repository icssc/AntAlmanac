{
    "extends": ["@total-typescript/tsconfig/bundler/dom", "../../tsconfig.base.json"],
    "compilerOptions": {
        "lib": ["es2024", "esnext.collection", "dom", "dom.iterable"],
        "jsx": "react-jsx",
        "plugins": [
            {
                "name": "next"
            }
        ],
        "baseUrl": ".",
        "paths": {
            "$actions/*": ["../antalmanac-scheduler/site/src/actions/*"],
            "$backend/*": ["../antalmanac-scheduler/site/src/backend/*"],
            "$components/*": ["../antalmanac-scheduler/site/src/components/*"],
            "$generated/*": ["../antalmanac-scheduler/site/src/generated/*"],
            "$lib/*": ["../antalmanac-scheduler/site/src/lib/*"],
            "$hooks/*": ["../antalmanac-scheduler/site/src/hooks/*"],
            "$providers/*": ["../antalmanac-scheduler/site/src/providers/*"],
            "$stores/*": ["../antalmanac-scheduler/site/src/stores/*"],
            "$src/*": ["../antalmanac-scheduler/site/src/*"],
            "$scripts/*": ["../antalmanac-scheduler/site/scripts/*"]
        }
    },
    "include": [
        "./dist/types/**/*.ts",
        "./next-env.d.ts",
        "./src",
        "./tests",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        "./scripts"
    ],
    "exclude": ["./node_modules"]
}
