        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@opentelemetry/auto-instrumentations-node": "0.58.0",
        "@trpc/server": "^11.17.0",
        "@vendia/serverless-express": "^4.12.6",
        "arctic": "^3.7.0",
        "connect-pg-simple": "^10.0.0",
        "cookie-parser": "^1.4.7",
        "dotenv-flow": "^4.1.0",
        "drizzle-orm": "^0.45.2",
        "express": "^4.21.1",
        "express-session": "^1.18.1",
        "morgan": "^1.10.0",
        "pg": "^8.16.3",
        "zod": "^3.24.3"
    },
    "devDependencies": {
        "@peterportal/types": "workspace:*",
        "@types/connect-pg-simple": "^7.0.3",
        "@types/cookie-parser": "^1.4.8",
        "@types/dotenv-flow": "^3.3.3",
        "@types/express": "^5.0.0",
        "@types/express-session": "^1.18.1",
        "@types/morgan": "^1.9.9",
        "@types/pg": "^8.11.10",
        "drizzle-kit": "^0.30.6",
        "nodemon": "^3.1.7",
        "oxlint": "1.70.0",
        "tsx": "^4.19.2",
        "typescript": "^5.9.3"
    }
