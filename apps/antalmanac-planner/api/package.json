{
    "name": "@antalmanac-planner/api",
    "version": "1.0.0",
    "main": "src/app.ts",
    "type": "module",
    "scripts": {
        "dev": "nodemon --exec tsx ./src/app.ts",
        "build": "tsc",
        "lint": "oxlint . --report-unused-disable-directives --deny-warnings && tsc --noEmit",
