{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "ignorePatterns": [
        "**/node_modules/**",
        "**/.next/**",
        "**/dist/**",
        "**/build/**",
        "**/.turbo/**",
        "**/coverage/**",
        "**/public/**",
        "apps/antalmanac-scheduler/site/src/generated/**",
        "apps/antalmanac-scheduler/db/migrations/**",
        "apps/antalmanac-planner/types/src/generated/**",
        "packages/anteater-api/src/types/generated**",
        "apps/ios/**"
    ],
    "experimentalSortImports": {
        "enabled": true,
        "groupImports": true
    }
}
