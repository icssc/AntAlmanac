{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["eslint", "react", "unicorn", "oxc", "typescript"],
    "rules": {
        "sort-imports": [
            "error",
            {
                "ignoreDeclarationSort": true
            }
        ],
        // Temporary for TS v6 migration, fix asap: https://github.com/icssc/AntAlmanac/issues/2096
        "react/set-state-in-effect": "off",
        "react/refs": "off"
    },
    "globals": {},
    "ignorePatterns": [
        "**/node_modules/**",
        "**/.next/**",
        "**/dist/**",
        "**/build/**",
        "**/.turbo/**",
        "**/coverage/**",
        "**/public/**",
        "apps/antalmanac/src/generated/**",
        "packages/db/migrations/**",
        "apps/ios/**"
    ]
}
